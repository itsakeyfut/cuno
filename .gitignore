# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
# Build output of the cuno workspace
/target/

# Backup files generated by rustfmt
**/*.rs.bk

# Profiling / coverage output
*.profraw
*.profdata
/coverage/
lcov.info
tarpaulin-report.html
flamegraph.svg
perf.data
perf.data.old

# Snapshot test artifacts pending review (insta)
*.snap.new
*.pending-snap

# ---------------------------------------------------------------------------
# Artifacts produced by cuno itself
# (integration tests and manual runs create C/C++ projects inside this repo)
# ---------------------------------------------------------------------------
# Build output of C/C++ projects built by cuno
**/target/

# Machine-specific config
**/.cuno/

# Files generated by cuno at the project root
**/compile_commands.json
**/.clang-format
**/.clang-tidy

# Scratch projects created while testing cuno by hand
/scratch/
/tmp/

# ---------------------------------------------------------------------------
# C / C++ build artifacts
# ---------------------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe
*.pdb
*.ilk
*.exp
*.idb
*.pch
*.gch
*.d
*.spv

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
.cache/
.clangd/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

